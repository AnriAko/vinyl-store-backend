{
    "name": "leverx-final",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "npm run prettier:format && npm run lint:fix && nest build",
        "start": "nest start",
        "dev": "nest start --watch",
        "debug": "nest start --debug --watch",
        "prod": "node dist/main",
        "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
        "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate src/infrastructure/migrations/InitSchema -d src/infrastructure/database/data-source.ts",
        "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/infrastructure/database/data-source.ts",
        "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/infrastructure/database/data-source.ts",
        "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.spec.ts\" --fix",
        "lint:check": "eslint \"src/**/*.ts\" \"src/**/*.spec.ts\"",
        "prettier:format": "prettier --write \"src/**/*.ts\"",
        "prettier:check": "prettier --check \"src/**/*.ts\"",
        "test": "node --test --require ./node.test.config.ts \"src/**/*.spec.ts\" \"src/**/*.e2e-spec.ts\"",
        "test:watch": "nodemon --exec \"npm run test\" --ext ts",
        "test:cov": "ts-node ./coverage-cli.ts",
        "test:debug": "node --inspect-brk --test --require ./node.test.config.ts \"src/**/*.spec.ts\" \"src/**/*.e2e-spec.ts\"",
        "prepare": "husky install"
    },
    "dependencies": {
        "@nestjs-modules/mailer": "^2.0.2",
        "@nestjs/cache-manager": "3.0.1",
        "@nestjs/common": "11.1.6",
        "@nestjs/config": "4.0.2",
        "@nestjs/core": "11.1.6",
        "@nestjs/event-emitter": "3.0.1",
        "@nestjs/jwt": "11.0.1",
        "@nestjs/mapped-types": "*",
        "@nestjs/passport": "11.0.5",
        "@nestjs/platform-express": "11.1.6",
        "@nestjs/swagger": "11.2.0",
        "@nestjs/typeorm": "11.0.0",
        "axios": "1.13.0",
        "bcrypt": "6.0.0",
        "cache-manager-redis-store": "3.0.1",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.2",
        "cookie-parser": "1.4.7",
        "express-rate-limit": "8.1.0",
        "glob": "^11.0.3",
        "googleapis": "164.0.0",
        "helmet": "8.1.0",
        "ioredis": "5.8.1",
        "jsonwebtoken": "9.0.2",
        "mysql2": "^3.15.2",
        "nodemailer": "^7.0.9",
        "passport": "0.7.0",
        "passport-google-oauth20": "2.0.0",
        "passport-jwt": "4.0.1",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.1",
        "sqlite3": "5.1.7",
        "stripe": "^19.1.0",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.27",
        "uuid": "^13.0.0",
        "winston": "3.18.3"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.0",
        "@nestjs/schematics": "11.0.0",
        "@nestjs/testing": "^11.1.7",
        "@swc/cli": "0.6.0",
        "@swc/core": "1.10.7",
        "@types/bcrypt": "6.0.0",
        "@types/express": "5.0.0",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "22.18.8",
        "@types/nodemailer": "7.0.2",
        "@types/passport-google-oauth20": "^2.0.16",
        "eslint": "9.37.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.4",
        "globals": "16.0.0",
        "husky": "8.0.0",
        "nodemon": "^3.1.10",
        "prettier": "3.6.2",
        "source-map-support": "0.5.21",
        "supertest": "^7.1.4",
        "ts-loader": "9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "8.20.0"
    },
    "overrides": {
        "@nestjs-modules/mailer": {
            "mjml": "^5.0.0-alpha.4"
        },
        "preview-email": {
            "nodemailer": "^7.0.9"
        },
        "class-validator": {
            "validator": "^13.11.0"
        }
    }
}
